[Unit]
Description=Sync the bioconductor.org docroot to R2
Documentation=file:///home/davsean/Documents/git/bioc-site/MIGRATION.md
# Never let the hourly sync and the weekly checksum pass run at once: they
# would fight over the same 453 GB of local disk, and the reconcile would be
# comparing a mirror that is being rewritten underneath it.
Conflicts=bioc-reconcile.service
After=network-online.target
Wants=network-online.target
# %N is the unit name with the .service suffix stripped -- bioc-notify@ then
# appends its own, so the instance is bioc-notify@bioc-sync.service, not a
# doubled suffix. See bioc-notify@.service and ../notify-failure.sh.
OnFailure=bioc-notify@%N.service

[Service]
Type=oneshot
WorkingDirectory=/home/davsean/Documents/git/bioc-site
EnvironmentFile=/home/davsean/Documents/git/bioc-site/.env
# RSYNC_SRC (the rrsync-restricted upstream source) comes from the
# EnvironmentFile above, which is gitignored: it is not a tracked value.
ExecStart=/home/davsean/Documents/git/bioc-site/sync.sh
# A pull of this size can legitimately take hours on a cold or heavily changed
# tree. The timer's Persistent=true means a missed run is caught up, so killing
# a slow one is safe -- but the ceiling has to be above a normal full pull.
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
